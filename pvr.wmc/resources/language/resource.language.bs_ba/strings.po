msgctxt "Addon Summary"
msgid "PVR WMC Client"
msgstr "PVR WMC klijent"

msgctxt "Addon Description"
msgid "A PVR client to interface with Windows Media Center's Recording and EPG services. Thanks to Tomba73 and Hoopsdavis. Special thanks to DBurckh."
msgstr "PVR klijent za povezivanje sa uslugama snimanja i EPG-a u programu Windows Media Center. Zahvaljujemo Tomba73 i Hoopsdavisu. Posebna zahvala DBurckhu."

msgctxt "Addon Disclaimer"
msgid "This is experimental software. Use at your own risk."
msgstr "Ovo je eksperimentalni softver. Koristite ga na vlastitu odgovornost."

msgctxt "#30000"
msgid "Server Hostname or IP"
msgstr "Naziv hosta ili IP adresa servera"

msgctxt "#30001"
msgid "Keep IP address to 127.0.0.1, if server is running on this same system"
msgstr "Zadržite IP adresu na 127.0.0.1, ako server radi na istom sistemu"

msgctxt "#30002"
msgid "Port Number"
msgstr "Broj porta"

msgctxt "#30003"
msgid "Stream timeout, unknown problem"
msgstr "Istek vremena streama, nepoznati problem"

msgctxt "#30004"
msgid "No video data found on this channel"
msgstr "Na ovom kanalu nisu pronađeni video podaci"

msgctxt "#30005"
msgid "Tuner is needed for recording"
msgstr "Za snimanje je potreban tjuner"

msgctxt "#30006"
msgid "Recording delete failed, file in use or write protected"
msgstr "Brisanje snimka nije uspjelo, datoteka se koristi ili je zaštićena od pisanja"

msgctxt "#30007"
msgid "Recording delete failed, recorded file doesn't exist"
msgstr "Brisanje snimka nije uspjelo, snimljena datoteka ne postoji"

msgctxt "#30008"
msgid "Recording file not found"
msgstr "Datoteka snimka nije pronađena"

msgctxt "#30009"
msgid "Alternate channel chosen: "
msgstr "Odabrani alternativni kanal: "

msgctxt "#30010"
msgid "Alternate time chosen: "
msgstr "Odabrano alternativno vrijeme: "

msgctxt "#30011"
msgid "Can't start, tuner is no longer available"
msgstr "Ne mogu pokrenuti, tjuner više nije dostupan"

msgctxt "#30012"
msgid "Channel content is protected"
msgstr "Sadržaj kanala je zaštićen"

msgctxt "#30013"
msgid "End time increased by "
msgstr "Vrijeme završetka povećano za "

msgctxt "#30014"
msgid "Enable SignalStatus calls"
msgstr "Omogući pozive SignalStatusa"

msgctxt "#30015"
msgid "Refresh SignalStatus Interval (sec)"
msgstr "Interval osvježavanja statusa signala (sek)"

msgctxt "#30016"
msgid "Store Resume/Watched status on server"
msgstr "Pohrani status nastavka/gledanja na serveru"

msgctxt "#30017"
msgid "Recorded TV folder not found"
msgstr "Folder snimljenih TV programa nije pronađen"

msgctxt "#30018"
msgid "Recorded TV folder cannot be opened"
msgstr "Folder snimljenih TV emisija se ne može otvoriti"

msgctxt "#30019"
msgid "ServerWMC version update is available (%s)"
msgstr "Dostupno je ažuriranje verzije ServerWMC-a (0})"

msgctxt "#30020"
msgid "All tuners for this channel are busy"
msgstr "Svi tjuneri za ovaj kanal su zauzeti"

msgctxt "#30021"
msgid "LiveTV timed-out"
msgstr "Vremensko ograničenje LiveTV-a je isteklo"

msgctxt "#30022"
msgid "LiveTV error, exited early"
msgstr "Greška u LiveTV-u, prerano isključeno"

msgctxt "#30023"
msgid "Recording stream timed-out"
msgstr "Vremensko ograničenje snimanja streama je isteklo"

msgctxt "#30024"
msgid "Recording stream exited early"
msgstr "Snimanje toka je ranije završeno"

msgctxt "#30025"
msgid "Use WakeOnLAN to wake up server"
msgstr "Koristite WakeOnLAN za buđenje servera"

msgctxt "#30026"
msgid "Sending WakeOnLAN to server..."
msgstr "Slanje WakeOnLAN-a na server..."

msgctxt "#30027"
msgid "Time drift between client and backend of %s minutes"
msgstr "Vremenski pomak između klijenta i izokrajne aplikacije iznosi %s minuta"

